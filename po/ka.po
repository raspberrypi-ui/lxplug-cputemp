#: src/cputemp.c:56
msgid "Foreground colour"
msgstr "წინა პლანის ფერი"

#: src/cputemp.c:57
msgid "Background colour"
msgstr "ფონის ფერი"

#: src/cputemp.c:58
msgid "Colour when ARM frequency capped"
msgstr "ფერი, როცა ARM-ის სიხშირე მაქსიმუმზეა"

#: src/cputemp.c:59
msgid "Colour when throttled"
msgstr "ფერი, როცა იზღუდება"

#: src/cputemp.c:60
msgid "Lower temperature bound"
msgstr "ტემპერატურის ქვედა ზღვარი"

#: src/cputemp.c:61
msgid "Upper temperature bound"
msgstr "ტემპერატურის ზედა ზღვარი"

#: src/cputemp.c:518
msgid "Display CPU temperature"
msgstr "CPU-ის ტემპერატურის ჩვენება"

