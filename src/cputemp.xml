<?xml version="1.0"?>
<wf-panel-pi>
  <plugin name="cputemp">
	<group>
	  <option name="foreground" type="string">
		<default>dark gray</default>
	  </option>
	  <option name="background" type="string">
		<default>light gray</default>
	  </option>
	  <option name="throttle_1" type="string">
		<default>orange</default>
	  </option>
	  <option name="throttle_2" type="string">
		<default>red</default>
	  </option>
	  <option name="low_temp" type="int">
		<default>40</default>
	  </option>
	  <option name="high_temp" type="int">
		<default>90</default>
	  </option>
	</group>
  </plugin>
</wf-panel-pi>
